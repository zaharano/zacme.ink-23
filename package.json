		"@playwright/test": "^1.57.0",
		"@sveltejs/adapter-auto": "^3.3.1",
		"@sveltejs/adapter-vercel": "^6.2.0",
		"@sveltejs/kit": "^2.49.2",
		"@sveltejs/vite-plugin-svelte": "^3.1.2",
		"@types/cookie": "^0.5.1",
		"@types/fluent-ffmpeg": "^2.1.28",
		"@types/smoothscroll-polyfill": "^0.3.1",
